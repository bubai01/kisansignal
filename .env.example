DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PG_POOL_MAX=5
PGSSL=require
CORS_ORIGIN=
# ---- required in production ----
SECRET=change-me-to-a-long-random-string        # openssl rand -hex 32
ADMIN_TOKEN=change-me-to-another-long-random-string   # password for /admin
DOMAIN=kisan.example.com

# ---- SMS / WhatsApp: console (testing only) | twilio | msg91 ----
SMS_PROVIDER=console
ALLOW_DEV_OTP=0            # 1 = show the code on screen while SMS_PROVIDER=console (demo only, never in production)
# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=               # a Twilio number like +1415..., or a Messaging Service SID starting with MG
TWILIO_WHATSAPP_FROM=      # e.g. whatsapp:+14155238886 (Twilio sandbox) or your approved WhatsApp sender
# MSG91 (India)
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=   # template variables: ##region## ##level## ##rain##

# ---- AI advisor (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ADVISOR_PER_DAY=20         # questions per farmer per day (cost guard)

# ---- flood alerts ----
ALERTS_ENABLED=1
ALERT_INTERVAL_MIN=180     # how often forecasts are checked
ALERT_RAIN_MM=50           # heavy rain in one day within the next 3 days
ALERT_SEVERE_MM=100
MAX_ALERTS_PER_RUN=500     # cost guard: stops sending after this many messages in one run
